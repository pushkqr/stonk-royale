generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}


model User {
  id         String       @id @default(uuid())
  oauth_id   String?      @unique // For Google login later
  username   String
  avatar_url String?
  createdAt  DateTime     @default(now())
  rooms      RoomPlayer[]
}

model Room {
  id               String       @id @default(uuid())
  room_code        String       @unique // The 5-letter invite code
  status           String       @default("WAITING") // WAITING, ACTIVE, COMPLETED
  start_time       DateTime?
  end_time         DateTime?
  starting_balance Float        @default(100000.0) // 100k starting cash
  players          RoomPlayer[]
}

model RoomPlayer {
  id             String        @id @default(uuid())
  user_id        String
  room_id        String
  available_cash Float         // Drops when they buy, rises when they sell
  is_ready       Boolean       @default(false) // For the lobby
  joined_at      DateTime      @default(now())
  
  user           User          @relation(fields: [user_id], references: [id])
  room           Room          @relation(fields: [room_id], references: [id])
  holdings       Holding[]
  transactions   Transaction[]

  @@unique([user_id, room_id]) // A user can only join a specific room once
}

model Holding {
  id               String     @id @default(uuid())
  room_player_id   String
  ticker           String     // e.g., 'BTC', 'DOGE'
  quantity         Float      // How much they own
  average_buy_price Float     // To calculate their profit/loss

  player           RoomPlayer @relation(fields: [room_player_id], references: [id])

  @@unique([room_player_id, ticker]) // One row per coin per player
}

model Transaction {
  id             String     @id @default(uuid())
  room_player_id String
  ticker         String
  type           String     // "BUY" or "SELL"
  quantity       Float
  price          Float      // The price executed at
  timestamp      DateTime   @default(now())

  player         RoomPlayer @relation(fields: [room_player_id], references: [id])
}
