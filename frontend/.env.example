# Everything here is optional. With no .env at all the game runs guest-only against the
# API on the same origin, which is what the Docker image does.

# Only needed when the API is on a different host than the frontend.
# VITE_API_URL=https://your-api-host/api

# Enables the optional "sign in" button. Leave unset and everyone plays as a guest.
# These are Firebase web config values, which are safe to expose publicly.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
